{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "finance-pro/backend",
  "type": "project",
  "description": "Finance Pro API backend",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always tests"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
